# Example env for local email sender
# Copy to .env and fill values (DO NOT COMMIT real passwords)

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# SMTP settings (from your hosting provider / control panel)
SMTP_HOST=mail.bodyfirst.uk
SMTP_PORT=465
SMTP_USER=website@bodyfirst.uk
SMTP_PASS=your_email_password_here
SMTP_SECURE=true

# Email recipient (optional)
CONTACT_TO=info@bodyfirst.uk

# Frontend should point to this endpoint (set in your Vite env or runtime env)
# For development, set VITE_CONTACT_FORM_ENDPOINT=http://localhost:3001/api/send-email

*** End Patch